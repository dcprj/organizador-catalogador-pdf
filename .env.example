# ==============================================================================
# Organizador e Catalogador de PDFs
# Arquivo de exemplo de configuração de ambiente (.env)
# ==============================================================================
#
# Escopo da Aplicação:
# - Processamento exclusivo de documentos acadêmicos, didáticos e editoriais:
#   livros, artigos científicos, teses, dissertações, apostilas e relatórios técnicos.
# - A aplicação NÃO trata dados sensíveis. O operador deve alimentar apenas documentos
#   de acervo editorial e acadêmico.
# - Extração estrutural de Ficha Catalográfica (CIP/AACR2) e metadados de cabeçalho.
# - Padronização e formatação estrita conforme ABNT NBR 6023:2018.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Classificação Documental Jev (TypeSafe AI)
# ------------------------------------------------------------------------------
# ORGPDF_CLASSIFICADOR define o modo do classificador em todas as entradas:
#   • 'jev_remoto' ou 'remoto' (PADRÃO UNIFORME EM TODAS AS INTERFACES):
#     Chamada remota ao TypeSafe AI / Jev.
#     Cada PDF gera uma chamada remota nova (sem reaproveitamento de cache do JEV).
#     Apenas uma amostra de até 3.000 caracteres de texto nativo é transmitida
#     (o arquivo PDF completo NUNCA é enviado pela rede).
#     Comportamentos estritos:
#       - Sem TYPESAFE_API_KEY: Config.validar() e JevClassifier levantam ErroDeConfiguracao.
#       - Sem typesafe-sdk instalado: levanta ErroDeClassificacaoRemota.
#       - Não há fallback silencioso para local no modo remoto.
#   • 'local': Executa exclusivamente o motor heurístico local determinístico (offline).
ORGPDF_CLASSIFICADOR=jev_remoto

# TYPESAFE_API_KEY: Chave de API da plataforma TypeSafe AI (obrigatória para modo remoto).
# Obtenha em https://typesafe.ai
TYPESAFE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Enriquecimento Bibliográfico em Bases Públicas Abertas
# ------------------------------------------------------------------------------
# ORGPDF_VERIFICAR_ONLINE habilita buscas bibliográficas externas estruturadas
# (Brasil API / CBL para ISBN, Crossref e DataCite para DOI, Google Books, OpenLibrary, OpenAlex).
ORGPDF_VERIFICAR_ONLINE=true

# ORGPDF_CACHE_BIBLIOGRAFICO: Ativa cache local em disco (~/.cache/organizador_pdf/bibliographic_cache.json).
#   - Quando true (padrão): respostas recuperadas do cache são registradas nos logs
#     com cache_hit=true e origem_resposta="cache_disco" para auditoria estrita.
#   - Quando false: desativa o cache bibliográfico em disco, forçando todas as buscas pela rede.
ORGPDF_CACHE_BIBLIOGRAFICO=true

# Chave opcional de API do Google Books (aumenta o limite de requisições por minuto):
#GOOGLE_BOOKS_API_KEY=

# Chave opcional de API do SerpApi (250 buscas gratuitas/mês para fallback do Google Scholar):
#SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Limites de Amostragem Textual e Proteção de Arquivos
# ------------------------------------------------------------------------------
# Quantidade de páginas iniciais e finais amostradas para análise nativa (padrão: 10):
#ORGPDF_MAX_PAGINAS=10

# Limite máximo de caracteres analisados localmente (padrão: 30000):
#ORGPDF_MAX_CARACTERES=30000

# Limite máximo de tamanho do arquivo PDF em megabytes (padrão: 500 MB):
#ORGPDF_MAX_FILE_SIZE_MB=500
