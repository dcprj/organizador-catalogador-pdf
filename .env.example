# ==============================================================================
# Organizador e Catalogador Inteligente de PDFs (v0.4.0+)
# Arquivo de exemplo de configuração de ambiente (.env)
# ==============================================================================
#
# A partir da v0.4.0, este aplicativo utiliza um MOTOR DETERMINÍSTICO E RESILIENTE:
# - Zero custo por token e 100% de privacidade na execução padrão.
# - Não depende de servidores Ollama nem de chaves de provedores LLM legados.
# - Decodificação de Ficha Catalográfica (CIP/AACR2) nas páginas iniciais.
# - Formatação estrita conforme a norma ABNT NBR 6023:2018.
# - Consultas gratuitas a bases bibliográficas públicas (Brasil API/CBL, Crossref, etc.).
#
# Nenhuma variável abaixo é obrigatória; todos os valores possuem padrões sensatos.

# ------------------------------------------------------------------------------
# 1. Enriquecimento Bibliográfico em Bases Públicas Abertas
# ------------------------------------------------------------------------------
# ORGPDF_VERIFICAR_ONLINE controla as consultas a bases bibliográficas públicas
# (Brasil API / CBL para ISBN, Crossref para DOI, OpenAlex, Google Books e OpenLibrary).
# NENHUM arquivo PDF nem texto integral é enviado por esta etapa (apenas identificadores/título).
# Para desativar consultas bibliográficas externas: false / 0 / nao.
# OBS: Para operação 100% offline (zero tráfego de rede), configure ORGPDF_VERIFICAR_ONLINE=false
# e mantenha TYPESAFE_API_KEY vazia/não definida.
ORGPDF_VERIFICAR_ONLINE=true

# Chave opcional de API do Google Books (aumenta o limite de requisições por minuto):
#GOOGLE_BOOKS_API_KEY=

# ------------------------------------------------------------------------------
# 2. Classificação Bibliográfica Jev (TypeSafe AI / Heurísticas Locais)
# ------------------------------------------------------------------------------
# ORGPDF_CLASSIFICADOR define a política de classificação documental:
#   • 'auto' (padrão): usa TypeSafe AI remoto se TYPESAFE_API_KEY estiver presente e o SDK instalado; caso contrário, usa heurísticas locais.
#   • 'local': força o uso exclusivo do motor heurístico calibrado local (zero rede).
#   • 'remoto' ou 'jev_remoto': modo exclusivo TypeSafe AI remoto. Exige TYPESAFE_API_KEY e typesafe-sdk;
#     FALHA imediatamente com erro claro se a chave faltar, o SDK não estiver instalado ou a API falhar (SEM fallback silencioso).
#ORGPDF_CLASSIFICADOR=auto

# TYPESAFE_API_KEY: chave para a API TypeSafe AI / Jev remoto.
# Envia apenas uma amostra de até 3.000 caracteres de texto nativo (não envia o PDF integral).
# As requisições bem-sucedidas são armazenadas em cache idempotente para evitar cobranças duplicadas em caso de reexecução.
#TYPESAFE_API_KEY=

# ------------------------------------------------------------------------------
# 3. Limites de Amostragem Textual e Proteção de Arquivos
# ------------------------------------------------------------------------------
# Padrões embutidos no código da aplicação (Config): 10 páginas e 30.000 caracteres.
# Altere ou descomente apenas se desejar limites customizados.

# Quantidade de páginas iniciais e finais amostradas (padrão: 10):
#ORGPDF_MAX_PAGINAS=10

# Teto de caracteres da amostra textual enviada para análise (padrão: 30000):
#ORGPDF_MAX_CARACTERES=30000

# Limite máximo de tamanho do arquivo PDF em megabytes (padrão: 500 MB):
# Evita consumo excessivo de memória ao abrir PDFs corrompidos ou não-otimizados.
#ORGPDF_MAX_FILE_SIZE_MB=500
