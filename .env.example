# Copie para `.env` e ajuste se necessário. O arquivo .env NUNCA deve ser
# versionado (já está no .gitignore) — ainda mais importante agora que ele
# pode conter chaves de API.
#
# Por padrão este aplicativo usa exclusivamente um LLM local via Ollama
# (https://ollama.com) — sem chave de API, sem custo por token, nada sai da
# sua máquina. Todas as variáveis abaixo são opcionais e têm um padrão
# sensato.

# Modelo do Ollama usado na extração (precisa já estar baixado: `ollama pull
# qwen2.5:3b-instruct`). Bom equilíbrio entre qualidade e RAM em máquinas com
# 8 GB. Dá para trocar sem editar este arquivo: organizador-pdf --modelo <nome>
ORGPDF_MODELO=qwen2.5:3b-instruct

# Endereço do servidor Ollama.
ORGPDF_OLLAMA_URL=http://localhost:11434

# Provedor do LLM: ollama (padrão, local e gratuito), anthropic, openai,
# deepseek, gemini ou grok. Os pagos exigem ORGPDF_MODELO explícito (ex.:
# claude-sonnet-5, gpt-5-mini, deepseek-v4-flash, gemini-2.5-flash, grok-4) e uma
# chave de API — veja as variáveis abaixo. Também dá pra trocar sem editar
# este arquivo: organizador-pdf --provedor anthropic --modelo claude-sonnet-5
#ORGPDF_PROVEDOR=ollama

# Chave de API do provedor pago escolhido. Pode usar a variável específica de
# cada um (tem prioridade) ou esta genérica como fallback — útil se você só
# usa um provedor pago de cada vez e não quer repetir a variável.
#ORGPDF_API_KEY=
#ORGPDF_ANTHROPIC_API_KEY=
#ORGPDF_OPENAI_API_KEY=
#ORGPDF_DEEPSEEK_API_KEY=
#ORGPDF_GEMINI_API_KEY=
#ORGPDF_GROK_API_KEY=

# Provedor pago acionado só quando a extração do provedor principal falha ou
# sai com aviso de divergência de nome de arquivo — desligado por padrão,
# nenhuma chamada extra é feita sem isto. Útil para manter o Ollama como
# padrão (grátis, privado) e só pagar por uma segunda opinião nos casos
# incertos. Exige um modelo explícito e uma chave de API (reaproveita as
# mesmas variáveis ORGPDF_<PROVEDOR>_API_KEY acima). Também dá pra configurar
# via CLI: organizador-pdf --provedor-fallback anthropic --modelo-fallback
# claude-sonnet-5
#ORGPDF_PROVEDOR_FALLBACK=
#ORGPDF_MODELO_FALLBACK=

# Quantas páginas iniciais do PDF são enviadas ao modelo.
ORGPDF_MAX_PAGINAS=6

# Teto de caracteres do trecho enviado ao modelo (corte adicional de segurança).
ORGPDF_MAX_CARACTERES=15000

# Verificação cruzada opcional do ISBN/DOI extraído contra bases públicas
# (Crossref para DOI, Open Library para ISBN) — a única exceção ao
# funcionamento 100% offline. Não envia o PDF nem o texto extraído, só o
# código já obtido, e só para conferir se ele bate com o título/autor
# catalogados. Sem internet ou com as APIs fora do ar, é ignorada em
# silêncio e o app segue funcionando normalmente. Defina como false/0/nao
# para desativar e manter tudo offline.
ORGPDF_VERIFICAR_ONLINE=true

# OCR automático para PDFs digitalizados (sem camada de texto), via suporte
# nativo do pymupdf4llm a Tesseract. Só tem efeito se o Tesseract estiver
# instalado (veja o README) — sem isso, o comportamento é o de sempre
# (falha explícita nesse arquivo). Defina como false/0/nao para nunca
# tentar, mesmo com o Tesseract presente.
ORGPDF_OCR=true

# Idioma do OCR, no formato de 3 letras do Tesseract.
ORGPDF_OCR_IDIOMA=por
