# Copie para `.env` e ajuste se necessário. O arquivo .env NUNCA deve ser
# versionado (já está no .gitignore).
#
# Este aplicativo usa exclusivamente um LLM local via Ollama (https://ollama.com)
# — sem chave de API, sem custo por token, nada sai da sua máquina. Todas as
# variáveis abaixo são opcionais e têm um padrão sensato.

# Modelo do Ollama usado na extração (precisa já estar baixado: `ollama pull
# qwen2.5:3b-instruct`). Bom equilíbrio entre qualidade e RAM em máquinas com
# 8 GB. Dá para trocar sem editar este arquivo: organizador-pdf --modelo <nome>
ORGPDF_MODELO=qwen2.5:3b-instruct

# Endereço do servidor Ollama.
ORGPDF_OLLAMA_URL=http://localhost:11434

# Quantas páginas iniciais do PDF são enviadas ao modelo.
ORGPDF_MAX_PAGINAS=6

# Teto de caracteres do trecho enviado ao modelo (corte adicional de segurança).
ORGPDF_MAX_CARACTERES=15000

# Verificação cruzada opcional do ISBN/DOI extraído contra bases públicas
# (Crossref para DOI, Open Library para ISBN) — a única exceção ao
# funcionamento 100% offline. Não envia o PDF nem o texto extraído, só o
# código já obtido, e só para conferir se ele bate com o título/autor
# catalogados. Sem internet ou com as APIs fora do ar, é ignorada em
# silêncio e o app segue funcionando normalmente. Defina como false/0/nao
# para desativar e manter tudo offline.
ORGPDF_VERIFICAR_ONLINE=true
